# =====================================================
# icctv-http-service 生产环境配置
# 部署时上传此文件到服务器并重命名为 .env
# =====================================================

# HTTP 服务配置
HTTP_ADDR=:8080

# 数据库配置（Docker 容器内部使用服务名作为主机名）
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=icctv
DB_PASS=1090119
DB_NAME=icctv_http_service

# MySQL Docker 配置
MYSQL_ROOT_PASSWORD=1090119
MYSQL_DATABASE=icctv_http_service
MYSQL_USER=icctv
MYSQL_PASSWORD=1090119
